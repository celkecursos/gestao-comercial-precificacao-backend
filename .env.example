# ------------------------------------------------------------
# Aplicação
# ------------------------------------------------------------
NODE_ENV=development
PORT=3000

# Origens permitidas no CORS, separadas por vírgula (ou * para todas).
# Ex.: http://localhost:5173,https://devfront.uno.com,https://homologfront.uno.com,https://front.uno.com
FRONTEND_URL=http://localhost:5173,http://localhost:4173

# Habilita a documentação Swagger em /api/docs
SWAGGER_ENABLED=true

# Quantos proxies reversos ficam na frente da API (1 = proxy da hospedagem; 0 = nenhum).
# Define de onde vem o IP real do cliente, usado no limite de pedidos de redefinição de senha.
TRUST_PROXY=1

# ------------------------------------------------------------
# Banco de dados (MySQL)
# Com o docker-compose deste projeto: DB_HOST=127.0.0.1 e DB_PORT=3307
# ------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=gestao_comercial
DB_USERNAME=gestao
DB_PASSWORD=
# Banco usado pelos testes e2e (apagado e recriado a cada execução)
DB_TEST_DATABASE=gestao_comercial_test
DB_LOGGING=false
# Executa migrations pendentes automaticamente ao iniciar a aplicação
DB_MIGRATIONS_RUN=false
# Executa os seeds de demonstração (idempotentes) ao iniciar, após as migrations.
# Use nos ambientes develop e homolog; mantenha false em produção.
DB_SEED_ON_STARTUP=false

# ------------------------------------------------------------
# Administrador inicial (opcional)
# Ao iniciar, se NÃO existir nenhum usuário ADMIN, cria este administrador.
# Se já existir um ADMIN, estas variáveis são ignoradas (a senha nunca é sobrescrita).
# Use para o primeiro acesso em produção; remova-as depois do primeiro login.
# Se uma for informada, as três são obrigatórias. A senha segue a política de senha forte.
# ------------------------------------------------------------
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ------------------------------------------------------------
# Autenticação
# Gere um segredo forte: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10

# ------------------------------------------------------------
# E-mail (recuperação de senha)
# MAIL_DRIVER=log  -> não envia; o e-mail (com o link) aparece no log da API.
#                     Use em desenvolvimento, testes e CI.
# MAIL_DRIVER=smtp -> envia pelo servidor SMTP abaixo. Use em homolog e produção.
#                     Com smtp, SMTP_*, MAIL_FROM e PASSWORD_RESET_URL são obrigatórias.
# Trocar de provedor (Hostinger, Gmail, SES, Mailgun...) é só trocar estas variáveis.
# ------------------------------------------------------------
MAIL_DRIVER=log
SMTP_HOST=
# 465 com SMTP_SECURE=true (TLS direto) ou 587 com SMTP_SECURE=false (STARTTLS)
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# Endereço e nome exibido do remetente
MAIL_FROM=
MAIL_FROM_NAME=Gestão Comercial e Precificação
# Tela do frontend que recebe ?token=... e define a nova senha.
# Com MAIL_DRIVER=log, o padrão é http://localhost:5173/redefinir-senha.
# Não é o FRONTEND_URL (aquele é a lista de origens do CORS).
PASSWORD_RESET_URL=
